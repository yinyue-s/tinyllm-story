# -----------------------------------------------------------------------------
# 1. 基础配置：数据库 / 静态文件 / 跨域
# -----------------------------------------------------------------------------

# SQLite 数据库地址（使用 sqlite:/// 协议，相对路径基于项目根）
# 示例：sqlite:///tinyllm.db  等价于 <项目根>/tinyllm.db
# 切换到 MySQL / PostgreSQL 时按 SQLAlchemy 规范修改，例如：
#   mysql+pymysql://root:123456@127.0.0.1:3306/tinyllm?charset=utf8mb4
TINYLLM_DATABASE_URL=sqlite:///tinyllm.db

# CORS 允许的前端源列表，使用英文逗号分隔；* 代表允许全部
# 示例：http://localhost:5173,http://localhost:8080
TINYLLM_CORS_ORIGINS=*


# -----------------------------------------------------------------------------
# 2. 安全：JWT 配置
# -----------------------------------------------------------------------------
# JWT 签名密钥：生产环境必须修改，至少 32 字节随机串
# 生成参考：python -c "import secrets; print(secrets.token_urlsafe(32))"
TINYLLM_JWT_SECRET=change-me-use-a-32-byte-random-string

# Token 有效期（小时）；默认 24
TINYLLM_TOKEN_TTL_HOURS=24


# -----------------------------------------------------------------------------
# 3. AI 能力：故事文本生成（OpenAI 兼容 API，推荐教学首选）
# -----------------------------------------------------------------------------
# 支持任何兼容 OpenAI /v1/chat/completions 的服务：
#   - DeepSeek : https://api.deepseek.com/v1    模型：deepseek-chat
#   - 通义千问  : https://dashscope.aliyuncs.com/compatible-mode/v1
#   - 智谱清言  : https://open.bigmodel.cn/api/paas/v4
#   - OpenAI    : https://api.openai.com/v1
# 优先级：TEXT_API 配置 > 下面 HuggingFace 本地模型 > 本地模板降级

# 服务地址（注意要包含 /v1 ，不要末尾再带斜杠）
TINYLLM_TEXT_API_URL=
# API Key
TINYLLM_TEXT_API_KEY=
# 模型名
TINYLLM_TEXT_API_MODEL=


# -----------------------------------------------------------------------------
# 4. AI 能力：故事文本生成（HuggingFace 本地模型，可选）
# -----------------------------------------------------------------------------
# 本地模型路径，例如：
#   C:/huggingface/models/Qwen2-0.5B-Instruct
# 留空代表不启用本地模型
TINYLLM_MODEL_PATH=


# -----------------------------------------------------------------------------
# 5. AI 能力：配图生成（OpenAI 兼容 /images/generations）
# -----------------------------------------------------------------------------
# 例如：DALL-E 3 / 通义万相 / 自定义 Stable Diffusion 代理
TINYLLM_IMAGE_API_URL=
TINYLLM_IMAGE_API_KEY=
TINYLLM_IMAGE_API_MODEL=

# 图片尺寸：常见取值 1024x1024 / 1024x1792 / 1792x1024
TINYLLM_IMAGE_SIZE=1024x1024


# -----------------------------------------------------------------------------
  # 6. AI 通用：请求超时 / 兼容 OpenAI SDK 环境变量
  # -----------------------------------------------------------------------------
  # 单次 AI 请求超时（秒）
  TINYLLM_AI_REQUEST_TIMEOUT=120

  # 兼容 OpenAI SDK / LangChain 等第三方库的环境变量别名
  # 它们与 TINYLLM_TEXT_API_* 效果等价，二选一配置即可；
  # 若同时设置，TINYLLM_* 变量优先级更高（参考 backend/config.py）
  OPENAI_BASE_URL=
  OPENAI_API_KEY=
  OPENAI_MODEL=


  # OpenAI兼容变量
OPENAI_BASE_URL=https://api.deepseek.com/v1

OPENAI_API_KEY=

OPENAI_MODEL=deepseek-v4-pro
